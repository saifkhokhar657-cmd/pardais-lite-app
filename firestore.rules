rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} { allow read: if signedIn(); allow create, update: if self(uid); allow delete: if false; }
    match /profiles/{uid} { allow read: if signedIn(); allow create, update: if self(uid); allow delete: if false; }
    match /user_settings/{uid} { allow read, write: if self(uid); }
    match /{document=**} { allow read, write: if false; }
  }
}
