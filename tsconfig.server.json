{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-server",
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "backend/auth.ts",
    "backend/agora.ts",
    "backend/firebase-admin.ts",
    "backend/firestore.ts",
    "backend/r2.ts"
  ]
}
